generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
}

enum LeadStatus {
  NEW
  CONTACTED
  NO_ANSWER
  CALLBACK
  QUALIFIED
  SALE
  REFUND
  INVALID
}

enum LeadStatusEventSource {
  SYSTEM
  WEBHOOK
  MANUAL
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  name         String
  email        String      @unique
  phone        String?
  passwordHash String      @map("password_hash")
  role         UserRole
  callCenterId String?     @map("call_center_id") @db.Uuid
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  callCenter   CallCenter? @relation(fields: [callCenterId], references: [id])

  @@index([callCenterId])
  @@map("users")
}

model CallCenter {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  code      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  users     User[]

  @@map("call_centers")
}

model Funnel {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  code           String          @unique
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  funnelProducts FunnelProduct[]

  @@map("funnels")
}

model Product {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  code           String          @unique
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  funnelProducts FunnelProduct[]

  @@map("products")
}

model FunnelProduct {
  id        String   @id @default(uuid()) @db.Uuid
  funnelId  String   @map("funnel_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  funnel    Funnel   @relation(fields: [funnelId], references: [id], onDelete: Restrict)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  leads     Lead[]

  @@unique([funnelId, productId])
  @@index([productId])
  @@map("funnel_products")
}

model Affiliate {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  code      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  leads     Lead[]

  @@map("affiliates")
}

model Lead {
  id             String            @id @default(uuid()) @db.Uuid
  name           String
  email          String
  phone          String
  funnelProductId String            @map("funnel_product_id") @db.Uuid
  affiliateId    String?           @map("affiliate_id") @db.Uuid
  source         String
  campaign       String?
  utmSource      String?           @map("utm_source")
  utmMedium      String?           @map("utm_medium")
  utmCampaign    String?           @map("utm_campaign")
  utmContent     String?           @map("utm_content")
  utmTerm        String?           @map("utm_term")
  status         LeadStatus        @default(NEW)
  idempotencyKey String            @unique @map("idempotency_key")
  requestHash    String            @map("request_hash")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  funnelProduct  FunnelProduct     @relation(fields: [funnelProductId], references: [id], onDelete: Restrict)
  affiliate      Affiliate?        @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  statusHistory  LeadStatusHistory[]

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([funnelProductId])
  @@index([affiliateId])
  @@index([source])
  @@map("leads")
}

model LeadStatusHistory {
  id          String                @id @default(uuid()) @db.Uuid
  leadId      String                @map("lead_id") @db.Uuid
  status      LeadStatus
  eventSource LeadStatusEventSource @map("event_source")
  occurredAt  DateTime              @default(now()) @map("occurred_at")
  lead        Lead                  @relation(fields: [leadId], references: [id], onDelete: Restrict)

  @@index([leadId, occurredAt])
  @@map("lead_status_history")
}
