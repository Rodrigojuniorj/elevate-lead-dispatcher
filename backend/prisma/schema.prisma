generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
}

enum LeadStatus {
  NEW
  CONTACTED
  NO_ANSWER
  CALLBACK
  QUALIFIED
  SALE
  REFUND
  INVALID
}

enum LeadStatusEventSource {
  SYSTEM
  WEBHOOK
  MANUAL
}

enum DistributionJobStatus {
  PENDING
  ENQUEUED
  COMPLETED
}

enum DistributionStrategy {
  SMOOTH_WEIGHTED_ROUND_ROBIN
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  name         String
  email        String      @unique
  phone        String?
  passwordHash String      @map("password_hash")
  role         UserRole
  callCenterId String?     @map("call_center_id") @db.Uuid
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  callCenter   CallCenter? @relation(fields: [callCenterId], references: [id])

  @@index([callCenterId])
  @@map("users")
}

model CallCenter {
  id             String                    @id @default(uuid()) @db.Uuid
  name           String                    @unique
  code           String                    @unique
  isActive       Boolean                   @default(true) @map("is_active")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")
  users          User[]
  dispatchConfig CallCenterDispatchConfig?
  distributions  Distribution[]

  @@map("call_centers")
}

model Funnel {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  code           String          @unique
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  funnelProducts FunnelProduct[]

  @@map("funnels")
}

model Product {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  code           String          @unique
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  funnelProducts FunnelProduct[]

  @@map("products")
}

model FunnelProduct {
  id        String   @id @default(uuid()) @db.Uuid
  funnelId  String   @map("funnel_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  funnel    Funnel   @relation(fields: [funnelId], references: [id], onDelete: Restrict)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  leads     Lead[]

  @@unique([funnelId, productId])
  @@index([productId])
  @@map("funnel_products")
}

model Affiliate {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  code      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  leads     Lead[]

  @@map("affiliates")
}

model Lead {
  id             String            @id @default(uuid()) @db.Uuid
  name           String
  email          String
  phone          String
  funnelProductId String            @map("funnel_product_id") @db.Uuid
  affiliateId    String?           @map("affiliate_id") @db.Uuid
  source         String
  campaign       String?
  utmSource      String?           @map("utm_source")
  utmMedium      String?           @map("utm_medium")
  utmCampaign    String?           @map("utm_campaign")
  utmContent     String?           @map("utm_content")
  utmTerm        String?           @map("utm_term")
  status         LeadStatus        @default(NEW)
  idempotencyKey String            @unique @map("idempotency_key")
  requestHash    String            @map("request_hash")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  funnelProduct  FunnelProduct     @relation(fields: [funnelProductId], references: [id], onDelete: Restrict)
  affiliate      Affiliate?        @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  statusHistory  LeadStatusHistory[]
  distributionJob DistributionJob?
  distribution    Distribution?

  @@index([createdAt, id])
  @@index([status, createdAt, id])
  @@index([funnelProductId, createdAt, id])
  @@index([affiliateId])
  @@index([source, createdAt, id])
  @@map("leads")
}

model LeadStatusHistory {
  id          String                @id @default(uuid()) @db.Uuid
  leadId      String                @map("lead_id") @db.Uuid
  status      LeadStatus
  eventSource LeadStatusEventSource @map("event_source")
  occurredAt  DateTime              @default(now()) @map("occurred_at")
  lead        Lead                  @relation(fields: [leadId], references: [id], onDelete: Restrict)

  @@index([leadId, occurredAt])
  @@map("lead_status_history")
}

model CallCenterDispatchConfig {
  id            String     @id @default(uuid()) @db.Uuid
  callCenterId  String     @unique @map("call_center_id") @db.Uuid
  weight        Int
  currentWeight Int        @default(0) @map("current_weight")
  isEnabled     Boolean    @default(true) @map("is_enabled")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  callCenter    CallCenter @relation(fields: [callCenterId], references: [id], onDelete: Restrict)

  @@index([isEnabled])
  @@map("call_center_dispatch_configs")
}

model DistributionJob {
  id            String                @id @default(uuid()) @db.Uuid
  leadId        String                @unique @map("lead_id") @db.Uuid
  status        DistributionJobStatus @default(PENDING)
  attempts      Int                   @default(0)
  lastError     String?               @map("last_error")
  nextAttemptAt DateTime?             @map("next_attempt_at")
  publishedAt   DateTime?             @map("published_at")
  completedAt   DateTime?             @map("completed_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  lead          Lead                  @relation(fields: [leadId], references: [id], onDelete: Restrict)

  @@index([status, publishedAt])
  @@map("distribution_jobs")
}

model Distribution {
  id            String               @id @default(uuid()) @db.Uuid
  leadId        String               @unique @map("lead_id") @db.Uuid
  callCenterId  String               @map("call_center_id") @db.Uuid
  strategy      DistributionStrategy
  appliedWeight Int                  @map("applied_weight")
  totalWeight   Int                  @map("total_weight")
  assignedAt    DateTime             @default(now()) @map("assigned_at")
  lead          Lead                 @relation(fields: [leadId], references: [id], onDelete: Restrict)
  callCenter    CallCenter           @relation(fields: [callCenterId], references: [id], onDelete: Restrict)

  @@index([callCenterId, assignedAt])
  @@index([callCenterId, leadId])
  @@map("distributions")
}
